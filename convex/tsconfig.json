{
    "compilerOptions": {
        "target": "ESNext",
        "module": "CommonJS",
        "moduleResolution": "Node",
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        /* Convex bundles the .ts sources directly. Emitting .js next to them
           creates duplicate modules that silently shadow schema/function edits. */
        "noEmit": true
    },
    "include": [
        "**/*"
    ],
    "exclude": [
        "node_modules"
    ]
}